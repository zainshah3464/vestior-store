# ============================================================
# VESTIOR — Environment Variables Reference
# Copy this file to `.env.local` and fill in actual values.
# NEVER commit `.env.local` to git.
# ============================================================

# ─── Supabase ────────────────────────────────────────────────
# Get from: Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...   # ⚠️ Server-only, never expose

# ─── Site ────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Upstash Rate Limiting ──────────────────────────────────
# Get from: https://console.upstash.com → Your DB → REST API
UPSTASH_REDIS_REST_URL=https://xxxxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=AXxxxx...

# ─── Google Analytics (Optional) ────────────────────────────
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX