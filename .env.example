# ============================================================
# VESTIOR — Environment Variables Reference
# Copy this file to `.env.local` and fill in actual values.
# NEVER commit `.env.local` to git.
# ============================================================

# ─── Supabase ────────────────────────────────────────────────
# Get from: Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...   # ⚠️ Server-only, never expose

# ─── Site ────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Upstash Rate Limiting ──────────────────────────────────
# Get from: https://console.upstash.com → Your DB → REST API
UPSTASH_REDIS_REST_URL=https://xxxxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=AXxxxx...

# ─── Google Analytics (Optional) ────────────────────────────
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# ── MongoDB Atlas (required) ─────────────────────────────────
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=vestior

# ── Security (required) ──────────────────────────────────────
# Generate with: openssl rand -hex 32
IP_HASH_SALT=replace-with-32-plus-random-chars
CRON_SECRET=replace-with-32-plus-random-chars

# ── Admin (required) ─────────────────────────────────────────
ADMIN_EMAIL=your-admin-email@example.com

# ── Future (Phase 2+) — leave blank for now ──────────────────
# RESEND_API_KEY=
# EMAIL_FROM=
# QSTASH_TOKEN=
# QSTASH_CURRENT_SIGNING_KEY=
# QSTASH_NEXT_SIGNING_KEY=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=
# PAYPAL_SANDBOX=true
# NEXT_PUBLIC_PAYPAL_CLIENT_ID=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
# NEXT_PUBLIC_CLOUDINARY_CLOUD=
# SENTRY_DSN=
